# ================================================================
#  .gitignore
# ================================================================
#
#  ⚠️ 有三类东西**绝对不能提交**，下面每条都写了原因。
#     这个仓库是公开的，提交上去就收不回来了。

# ----------------------------------------------------------------
# 🔴 第一类：孩子写字的现场照片（隐私，最高优先级）
# ----------------------------------------------------------------
# review/ 目录里是程序判定存疑时自动存的实拍图 + 家长审核标注，
# 是用来标定阈值的核心数据，**含孩子的影像**。
# hand_view/ 是握笔视角验证工具按 s 存下的画面。
# 这两个目录只能留在本机。
review/
hand_view/

# ----------------------------------------------------------------
# 🔴 第二类：本机个人数据
# ----------------------------------------------------------------
# config.json   记着摄像头索引、家长调过的阈值
# baseline.json 是**孩子本人**的坐姿基线（跟着机位和体型走，换台机器就没意义）
repos/p0-prototype/config.json
repos/p0-prototype/baseline.json

# ----------------------------------------------------------------
# 🟠 第三类：体积大的可再生产物
# ----------------------------------------------------------------
# 虚拟环境 541MB，纯本机产物
envs/
.venv/
venv/

# 模型权重 51MB（heavy 档单个 29MB）。
# GitHub 单文件上限 100MB、超 50MB 会警告，塞进来会永久拖大仓库体积。
# 需要时用 tools/fetch_models.py 下载。
*.task

# 语音的音量缩放缓存，可以从 wav 重新生成
repos/p0-prototype/voice/_vol_*/

# ----------------------------------------------------------------
# 常规
# ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# 编辑器 / 系统
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini

# 日志
*.log
